{
  "dataset": "paysafe_transactions_1000.csv",
  "rows": 1000,
  "fraudulent_rows": 171,
  "legitimate_rows": 829,
  "features": ["amount", "transaction_hour", "previous_transactions"],
  "model": "RandomForestClassifier",
  "hyperparameters": {
    "n_estimators": 500,
    "min_samples_leaf": 3,
    "class_weight": "balanced",
    "random_state": 42
  },
  "cross_validation": {
    "folds": 5,
    "stratified": true,
    "metrics_mean": {
      "accuracy": 0.983,
      "precision": 0.981985,
      "recall": 0.918151,
      "f1": 0.948697,
      "roc_auc": 0.983062,
      "average_precision": 0.963586
    },
    "metrics_std": {
      "accuracy": 0.002449,
      "precision": 0.023724,
      "recall": 0.011554,
      "f1": 0.00691,
      "roc_auc": 0.005893,
      "average_precision": 0.008905
    }
  },
  "holdout_20_percent": {
    "random_state": 42,
    "confusion_matrix": [[166, 0], [3, 31]]
  },
  "notes": "Transaction ID and categorical dataset columns were excluded because the current PaySafe Transaction Analyzer does not collect those fields. The model predicts from amount, transaction hour, and previous transaction frequency only."
}
